rules_version = '2';

// WonderLAD - Gestione Dolci Solidali
// Ruoli: Administrator (tutto) | Manager (ordini, ritiri, messaggi)
// Il ruolo vive in /utenti/{uid}.ruolo e NON e' scrivibile dall'utente stesso.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helper ----------
    function isAuth() {
      return request.auth != null;
    }

    function profilo() {
      return get(/databases/$(database)/documents/utenti/$(request.auth.uid)).data;
    }

    // Staff = utente autenticato CON una scheda in /utenti.
    function isStaff() {
      return isAuth()
        && exists(/databases/$(database)/documents/utenti/$(request.auth.uid));
    }

    function isAdmin() {
      return isStaff() && profilo().ruolo == 'Administrator';
    }

    function generali() {
      return get(/databases/$(database)/documents/impostazioni/generali).data;
    }

    function statiValidi() {
      return ['Prenotato', 'Prenotato - Da Pagare', 'Prenotato - Pagato',
              'In Preparazione', 'Da Consegnare', 'Consegnato', 'Annullato'];
    }

    function metodiValidi() {
      return ['-', 'Cash', 'Bonifico', 'POS'];
    }

    function testo(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ---------- ordini ----------
    match /ordini/{ordineId} {

      function campiPubblici() {
        return ['campagnaId', 'nome', 'cognome', 'telefono', 'email', 'righe', 'pezzi',
                'minimoTotale', 'offerta', 'note', 'codice', 'status', 'metodoPagamento',
                'origine', 'ricevuta', 'cf', 'indirizzo', 'cap', 'comune', 'provincia',
                'consensoPrivacy', 'privacyVersione', 'consensoMarketing', 'timestamp'];
      }

      // Codice fiscale: controllo di formato (il carattere di controllo lo verifica il modulo).
      function datiRicevutaValidi(d) {
        return (d.ricevuta == true
            && d.cf is string
            && d.cf.matches('^[A-Z]{6}[0-9LMNPQRSTUV]{2}[ABCDEHLMPRST][0-9LMNPQRSTUV]{2}[A-Z][0-9LMNPQRSTUV]{3}[A-Z]$')
            && testo(d.indirizzo, 1, 120)
            && d.cap is string && d.cap.matches('^[0-9]{5}$')
            && testo(d.comune, 1, 60)
            && d.provincia is string && d.provincia.matches('^[A-Z]{2}$'))
          || (d.ricevuta == false
            && d.cf == '' && d.indirizzo == '' && d.cap == '' && d.comune == '' && d.provincia == '');
      }

      // Prenotazione pubblica: schema chiuso, campagna attiva e aperta,
      // offerta non inferiore alla donazione minima.
      function prenotazioneValida(d) {
        let camp = get(/databases/$(database)/documents/campagne/$(d.campagnaId)).data;
        return d.campagnaId == generali().campagnaAttiva
          && camp.ordiniAperti == true
          && testo(d.nome, 1, 60)
          && testo(d.cognome, 1, 60)
          && d.telefono is string && d.telefono.matches('^[0-9]{8,15}$')
          && testo(d.email, 5, 120) && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && d.righe is list && d.righe.size() >= 1 && d.righe.size() <= 10
          && d.pezzi is int && d.pezzi >= 1 && d.pezzi <= 100
          && d.minimoTotale is number
          && d.minimoTotale + 0.01 >= d.pezzi * camp.get('minimoPezzo', 0)
          && d.offerta is number && d.offerta >= d.minimoTotale && d.offerta <= 100000
          && testo(d.note, 0, 300)
          && testo(d.codice, 6, 6)
          && d.status == 'Prenotato - Da Pagare'
          && d.metodoPagamento == '-'
          && d.origine == 'web'
          && d.ricevuta is bool
          && datiRicevutaValidi(d)
          && d.consensoPrivacy == true
          && d.privacyVersione is int
          && d.consensoMarketing is bool
          && d.timestamp == request.time;
      }

      allow create: if request.resource.data.keys().hasOnly(campiPubblici())
        && request.resource.data.keys().hasAll(campiPubblici())
        && prenotazioneValida(request.resource.data);

      allow read: if isStaff();

      // Il Manager modifica gli ordini ma non campagna, codice, data, origine e consensi.
      // L'Administrator puo' tutto (serve anche alla migrazione degli ordini storici).
      allow update: if isAdmin() || (isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome', 'cognome', 'telefono', 'email', 'righe', 'pezzi', 'minimoTotale',
                       'offerta', 'note', 'status', 'metodoPagamento', 'ritiro', 'ricevuta',
                       'cf', 'indirizzo', 'cap', 'comune', 'provincia', 'messaggi'])
        && request.resource.data.status in statiValidi()
        && request.resource.data.metodoPagamento in metodiValidi()
        && (!('offerta' in request.resource.data) || request.resource.data.offerta is number)
        && (!('righe' in request.resource.data) || request.resource.data.righe is list)
        && (!('messaggi' in request.resource.data) || (request.resource.data.messaggi is list && request.resource.data.messaggi.size() <= 200)));

      // Cancellare e' definitivo: solo Administrator. Di norma si usa "Annullato".
      allow delete: if isAdmin();
    }

    // ---------- campagne ----------
    // Lettura pubblica: il modulo mostra prodotti, descrizioni e donazioni minime.
    match /campagne/{campagnaId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.nome is string
        && request.resource.data.prodotti is map
        && request.resource.data.ordiniAperti is bool
        && request.resource.data.minimoPezzo is number;
      allow delete: if isAdmin();
    }

    // ---------- impostazioni ----------
    // generali (campagna attiva, contatti, informativa): lettura pubblica.
    // messaggi (modelli): solo staff. Scrittura: solo Administrator.
    // stock: documento della versione precedente, letto solo dalla migrazione.
    match /impostazioni/{docId} {
      allow read: if docId != 'messaggi' || isStaff();
      allow write: if isAdmin();
    }

    // ---------- utenti (ruoli) ----------
    // Nessuno puo' scrivere il proprio ruolo. Il primo Administrator si crea
    // a mano dalla console Firebase (la console non passa dalle rules).
    match /utenti/{uid} {
      allow get: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'ruolo', 'creato'])
        && request.resource.data.ruolo in ['Administrator', 'Manager'];
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // ---------- logs ----------
    match /logs/{logId} {
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['timestamp', 'categoria', 'utente', 'dettaglio'])
        && request.resource.data.utente == request.auth.token.email
        && request.resource.data.dettaglio is string
        && request.resource.data.dettaglio.size() <= 500
        && request.resource.data.timestamp == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- preferenze personali (layout dashboard) ----------
    match /preferenze/{uid} {
      allow read, delete: if isAuth() && request.auth.uid == uid;
      allow create, update: if isAuth() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['dashboard', 'aggiornato'])
        && request.resource.data.dashboard is list
        && request.resource.data.dashboard.size() <= 30;
    }

    // Tutto il resto e' chiuso.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
